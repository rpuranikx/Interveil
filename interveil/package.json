{
  "name": "interveil",
  "version": "0.1.0",
  "description": "Policy enforcement for AI agents: block disallowed tool calls before they run, with live traces and an audit trail",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "interveil": "dist/cli.js"
  },
  "files": [
    "dist/",
    "examples/policies/",
    "python/",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "cd src/ui && vite build --outDir ../../dist/ui",
    "dev": "ts-node src/cli.ts serve",
    "dev:ui": "cd src/ui && vite",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p src/ui/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "ai",
    "agent",
    "security",
    "policy",
    "guardrails",
    "prompt-injection",
    "claude-code",
    "mcp",
    "llm",
    "gateway",
    "tracing"
  ],
  "author": "Rishi Puranik",
  "license": "MIT",
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.1",
    "open": "^9.1.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpuranikx/Interveil.git",
    "directory": "interveil"
  }
}
