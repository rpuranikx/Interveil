# Copy to .env — `interveil serve` and `docker compose up` read it automatically.
# Every variable is optional.

# Shared secret for the trace API, gateway and WebSocket. Required before
# exposing the server beyond localhost. SDKs read it from this variable too.
INTERVEIL_API_KEY=

# Interface to bind. Defaults to 127.0.0.1; Docker sets 0.0.0.0 inside the container.
INTERVEIL_HOST=

# Provider keys used by the LLM gateway (/v1/proxy) when a client does not send
# its own `Authorization: Bearer` key. Leave empty for passthrough-only mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Upstream API base URLs. Set OPENAI_BASE_URL to use any OpenAI-compatible API
# (Azure OpenAI, OpenRouter, Ollama at http://localhost:11434/v1, ...).
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=

# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=

# Upstream MCP server for the /v1/mcp proxy.
MCP_SERVER_URL=
