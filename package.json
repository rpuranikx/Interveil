{
  "name": "interveil-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "pnpm --filter interveil run build",
    "test": "pnpm --filter interveil run test",
    "typecheck": "pnpm --filter interveil run typecheck",
    "lint": "pnpm --filter interveil run lint",
    "demo": "pnpm --filter interveil run build && node interveil/dist/cli.js demo",
    "bench": "pnpm --filter interveil run build && node interveil/dist/bench/gateway.js"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
